# Read from the project-root .env; copy values only into that root file.
GROQ_API_KEY = your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30
GROQ_RETRIES=2

# Preserve the notebook's embedding model for an existing compatible index.
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Switching this model requires a complete vector-index rebuild.

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.5
MAX_REQUEST_CHARACTERS=4000
MAX_CONTEXT_CHARACTERS=14000
MAX_RECENT_MESSAGES=12
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Required only to enable POST /api/v1/documents/ingest.
INGESTION_API_KEY=replace_with_a_long_random_value

# Optional. When MONGODB_URI is set, MongoDB stores session and ingestion metadata;
# Chroma remains the vector store. Otherwise, metadata and sessions use local SQLite.
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
HF_TOKEN=your_hugging_face_token
MONGODB_DATABASE=yojana_sahayak
