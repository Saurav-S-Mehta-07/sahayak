# Copy this file to .env and provide your own credentials.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
MAX_RESPONSE_TOKENS=1024

# Keep paths relative to the backend directory unless absolute paths are needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=vector_store
CHROMA_COLLECTION=pdf_documents
PDF_DIR=data/pdfs
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0

# Context budgets count prompt/history/documents plus the output reserve.
CONTEXT_WINDOW_TOKENS=12000
HISTORY_BUDGET_TOKENS=1800
DOCUMENT_BUDGET_TOKENS=7000
MAX_RECENT_MESSAGES=12

# Conversation memory is persisted locally in SQLite.
SQLITE_PATH=data/conversations.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when serving over HTTPS; local HTTP development should keep false.
SESSION_COOKIE_SECURE=false

# Optional official RSS/Atom feeds, comma-separated. Only HTTPS .gov.in/.nic.in
# feeds and item links are accepted. Discovery is disabled when this is blank.
SCHEME_DISCOVERY_FEEDS=
# Set to a positive number to poll on this interval; 0 disables scheduled polling.
SCHEME_DISCOVERY_INTERVAL_HOURS=0
